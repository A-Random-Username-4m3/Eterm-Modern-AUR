+/* Convert 8-bit RGB components into the actual X11 TrueColor visual's
+ * bit masks. We avoid allocating one X server colormap entry per RGB color.
+ * Indexed colors remain in the historical PixColors[] theme palette. */
+static Pixel
+eterm_truecolor_component(unsigned int channel, unsigned long mask)
+{
+    unsigned long shifted, scale;
+    unsigned int nshift = 0;
+    if (!mask)
+        return 0;
+    while (!(mask & 1UL)) {
+        mask >>= 1;
+        ++nshift;
+    }
+    shifted = mask;
+    scale = (unsigned long) ((channel * shifted + 127UL) / 255UL);
+    return (Pixel) (scale << nshift);
+}
+
+static Pixel
+eterm_rend_pixel(rend_t style, int background)
+{
+    unsigned int rgb, index;
+    if (background) {
+        if (!(style & RS_BGTrue)) {
+            index = GET_BGCOLOR(style);
+            return PixColors[index < ETERM_COLOR_STORAGE ? index : bgColor];
+        }
+        rgb = GET_BGRGB(style);
+    } else {
+        if (!(style & RS_FGTrue)) {
+            index = GET_FGCOLOR(style);
+            return PixColors[index < ETERM_COLOR_STORAGE ? index : fgColor];
+        }
+        rgb = GET_FGRGB(style);
+    }
+    if (!Xvisual || Xvisual->class != TrueColor)
+        return PixColors[background ? bgColor : fgColor];
+    return eterm_truecolor_component((rgb >> 16) & 255u, Xvisual->red_mask) |
+           eterm_truecolor_component((rgb >> 8) & 255u, Xvisual->green_mask) |
+           eterm_truecolor_component(rgb & 255u, Xvisual->blue_mask);
+}
+
+/* Called for SGR 38;2;r;g;b and 48;2;r;g;b on TrueColor visuals. */
+void
+scr_color_rgb(unsigned int red, unsigned int green, unsigned int blue,
+              unsigned int intensity)
+{
+    unsigned int rgb;
+    if (red > 255u || green > 255u || blue > 255u)
+        return;
+    rgb = (red << 16) | (green << 8) | blue;
+    if (intensity == RS_Bold)
+        rstyle = SET_FGRGB(rstyle, rgb);
+    else if (intensity == RS_Blink)
+        rstyle = SET_BGRGB(rstyle, rgb);
+}
