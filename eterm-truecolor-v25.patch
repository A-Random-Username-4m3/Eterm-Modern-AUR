+/* 64-bit rendition: [24-bit BG] [24-bit FG] [RGB flags] [14 attributes].
+ * Each 24-bit field holds a palette index (0..511) unless the corresponding
+ * RS_*True bit is set. No eviction, approximation or global RGB slot limit. */
+#define GET_FGRGB(r)          ((unsigned int)(((rend_t)(r) >> 16) & UINT64_C(0xffffff)))
+#define GET_BGRGB(r)          ((unsigned int)(((rend_t)(r) >> 40) & UINT64_C(0xffffff)))
+#define GET_FGCOLOR(r)        (((r) & RS_FGTrue) ? fgColor : GET_FGRGB(r))
+#define GET_BGCOLOR(r)        (((r) & RS_BGTrue) ? bgColor : GET_BGRGB(r))
+#define GET_ATTR(r)           ((r) & RS_attrMask)
+/* Conservative refresh rule for spaces: compare complete rendition so that
+ * a changed truecolor background never remains stale. */
+#define GET_BGATTR(r)         ((r) & (RS_attrMask | RS_BGTrue | RS_bgMask | RS_FGTrue | RS_fgMask))
+#define SET_FGCOLOR(r,fg)     ((((rend_t)(r)) & ~(RS_fgMask | RS_FGTrue)) | (((rend_t)(fg) & UINT64_C(0xffffff)) << 16))
+#define SET_BGCOLOR(r,bg)     ((((rend_t)(r)) & ~(RS_bgMask | RS_BGTrue)) | (((rend_t)(bg) & UINT64_C(0xffffff)) << 40))
+#define SET_FGRGB(r,rgb)      (SET_FGCOLOR((r),(rgb)) | RS_FGTrue)
+#define SET_BGRGB(r,rgb)      (SET_BGCOLOR((r),(rgb)) | RS_BGTrue)
+#define SET_ATTR(r,a)         ((((rend_t)(r)) & ~RS_attrMask) | ((rend_t)(a) & RS_attrMask))
+#define DEFAULT_RSTYLE        (SET_BGCOLOR(SET_FGCOLOR(RS_None,fgColor),bgColor))
 
