+/* Remove the whole glyph if any occupied cell is overwritten. */
+static void
+eterm_wide_clear_at(int row, int col, rend_t style)
+{
+    int cols = TERM_WINDOW_GET_REPORTED_COLS();
+    text_t *t = screen.text[row];
+    rend_t *r = screen.rend[row];
+    if (col < 0 || col >= cols || !t || !r)
+        return;
+    if (t[col] == ETERM_WIDE_TRAIL && col > 0) {
+        t[col - 1] = ' ';
+        r[col - 1] = style;
+    } else if (eterm_cell_width(t[col]) == 2 && col + 1 < cols &&
+               t[col + 1] == ETERM_WIDE_TRAIL) {
+        t[col + 1] = ' ';
+        r[col + 1] = style;
+    }
+    t[col] = ' ';
+    r[col] = style;
+}
+
+/* Shifts, resizes and erasures can divide pairs. Never leave an orphan. */
+static void
+eterm_wide_repair_cells(text_t *t, rend_t *r, int cols, rend_t style)
+{
+    int col;
+    if (!t || !r)
+        return;
+    for (col = 0; col < cols; ++col) {
+        if (t[col] == ETERM_WIDE_TRAIL) {
+            if (col == 0 || eterm_cell_width(t[col - 1]) != 2) {
+                t[col] = ' ';
+                r[col] = style;
+            }
+        } else if (eterm_cell_width(t[col]) == 2) {
+            if (col == cols - 1 || t[col + 1] != ETERM_WIDE_TRAIL) {
+                t[col] = ' ';
+                r[col] = style;
+            } else {
+                ++col;
+            }
+        }
+    }
+}
+
+static void
+eterm_wide_repair_row(int row, rend_t style)
+{
+    eterm_wide_repair_cells(screen.text[row], screen.rend[row],
+                            TERM_WINDOW_GET_REPORTED_COLS(), style);
+}
