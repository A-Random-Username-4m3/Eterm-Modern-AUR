+/* Encoder shared by PRIMARY selections and plain-text screen dumps.
+ * Codepoints are validated by the UTF-8 decoder at ingestion time.
+ */
+static int
+eterm_encode_utf8(text_t cp, char *out)
+{
+    if (cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff))
+        cp = 0xfffd;
+    if (cp <= 0x7f) {
+        out[0] = (char) cp;
+        return 1;
+    }
+    if (cp <= 0x7ff) {
+        out[0] = (char) (0xc0 | (cp >> 6));
+        out[1] = (char) (0x80 | (cp & 63));
+        return 2;
+    }
+    if (cp <= 0xffff) {
+        out[0] = (char) (0xe0 | (cp >> 12));
+        out[1] = (char) (0x80 | ((cp >> 6) & 63));
+        out[2] = (char) (0x80 | (cp & 63));
+        return 3;
+    }
+    out[0] = (char) (0xf0 | (cp >> 18));
+    out[1] = (char) (0x80 | ((cp >> 12) & 63));
+    out[2] = (char) (0x80 | ((cp >> 6) & 63));
+    out[3] = (char) (0x80 | (cp & 63));
+    return 4;
+}
