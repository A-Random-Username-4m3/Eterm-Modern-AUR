+    xcolor.red = (unsigned short) (red * 257);
+    xcolor.green = (unsigned short) (green * 257);
+    xcolor.blue = (unsigned short) (blue * 257);
+    xcolor.flags = DoRed | DoGreen | DoBlue;
+    if (!XAllocColor(Xdisplay, cmap, &xcolor))
+        return eterm_rgb_nearest(rgb);
+
+    idx = eterm_rgb_next++;
+    eterm_rgb_values[idx] = rgb;
+    PixColors[idx] = xcolor.pixel;
+    return idx;
+}
