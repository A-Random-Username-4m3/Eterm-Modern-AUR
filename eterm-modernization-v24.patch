+/* v22: Present an already-composited region of the backing pixmap.
+ * XClearArea() instead repaints the *window background*, potentially showing
+ * a cleared/old frame during rapid updates. Copying the completed region
+ * directly keeps the old contents visible until the new pixels arrive.
+ *
+ * This helper is only used while buffer_pixmap exists. It does not modify
+ * the image background or paint text, so the bitmap and Xft backends remain
+ * unchanged. Clip before issuing the X11 request (negative widths are not
+ * allowed by XCopyArea).
+ */
+static void
+eterm_present_pixmap_region(int x, int y, int width, int height)
+{
+    int maxwidth, maxheight;
+
+    if (!buffer_pixmap || width <= 0 || height <= 0)
+        return;
+    maxwidth = TermWin_TotalWidth();
+    maxheight = TermWin_TotalHeight();
+    if (x < 0) {
+        width += x;
+        x = 0;
+    }
+    if (y < 0) {
+        height += y;
+        y = 0;
+    }
+    if (width <= 0 || height <= 0 || x >= maxwidth || y >= maxheight)
+        return;
+    if (width > maxwidth - x)
+        width = maxwidth - x;
+    if (height > maxheight - y)
+        height = maxheight - y;
+    if (width <= 0 || height <= 0)
+        return;
+    XCopyArea(Xdisplay, buffer_pixmap, TermWin.vt, TermWin.gc,
+              x, y, (unsigned int) width, (unsigned int) height, x, y);
