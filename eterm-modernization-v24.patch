+static void
+eterm_cjk_load_fonts(void)
+{
+    const char *primary, *alternate, *override;
+    const char *families[ETERM_CJK_FACE_COUNT];
+    unsigned int i;
+    int size, minimum;
+    XftFont *face;
+    char *end;
+    long px;
+
+    if (eterm_cjk_ready)
+        return;
+    eterm_cjk_ready = 1;
+    primary = getenv("ETERM_CJK_FONT");
+    alternate = getenv("ETERM_CJK_FALLBACK");
+    families[0] = (primary && *primary) ? primary : "Noto Sans Mono CJK JP";
+    families[1] = (alternate && *alternate) ? alternate : "Noto Sans Mono CJK SC";
+
+    override = getenv("ETERM_CJK_PIXEL_SIZE");
+    px = 0;
+    if (override && *override) {
+        end = NULL;
+        px = strtol(override, &end, 10);
+        if (!end || *end || px < 6 || px > 64)
+            px = 0;
+    }
+
+    /* Match primary Xft pixel height unless the user requests a fixed size.
+     * A single size is selected for each face; never shrink an individual
+     * character or switch fonts merely because its ink bounds differ.
+     */
+    size = px ? (int) px : eterm_xft_pixel_height;
+    if (size < 6)
+        size = MAX(6, TermWin.fheight - 2);
+    minimum = px ? size : 6;
+    for (i = 0; i < ETERM_CJK_FACE_COUNT; i++) {
+        int trial;
+        face = NULL;
+        for (trial = size; trial >= minimum; trial--) {
+            face = eterm_cjk_open_face(families[i], trial);
+            if (!face)
+                continue;
+            if (px || eterm_cjk_sample_fits(face))
+                break;
+            XftFontClose(Xdisplay, face);
+            face = NULL;
+        }
+        eterm_cjk_faces[i] = face;
+    }
+}
+
+static XftFont *
+eterm_cjk_font_for(FcChar32 cp)
+{
+    unsigned int i;
+    if (!eterm_is_cjk(cp))
+        return NULL;
+    eterm_cjk_load_fonts();
+    for (i = 0; i < ETERM_CJK_FACE_COUNT; i++) {
+        if (eterm_cjk_faces[i] &&
+            XftCharExists(Xdisplay, eterm_cjk_faces[i], cp))
+            return eterm_cjk_faces[i];
+    }
+    return NULL;
+}
+
+static unsigned int eterm_xft_replace = 0;
+static eterm_xft_cache_entry_t eterm_xft_cache[ETERM_XFT_FALLBACK_CACHE];
+
+static void
+eterm_xft_close_fonts(void)
+{
+    unsigned int i;
+    for (i = 0; i < ETERM_XFT_FALLBACK_CACHE; i++) {
+        if (eterm_xft_cache[i].font) {
+            XftFontClose(Xdisplay, eterm_xft_cache[i].font);
+            eterm_xft_cache[i].font = NULL;
+        }
+        eterm_xft_cache[i].codepoint = 0;
+    }
+    eterm_xft_replace = 0;
+    eterm_cjk_close_fonts();
+    if (eterm_xft_primary) {
+        XftFontClose(Xdisplay, eterm_xft_primary);
+        eterm_xft_primary = NULL;
+    }
+}
+
+/* Used only to choose a primary font size matching Eterm's grid.
+ * Individual Unicode glyphs are NOT shrunk independently.
+ */
+static int
+eterm_xft_glyph_fits(XftFont *font, FcChar32 cp)
+{
+    XGlyphInfo ink;
+    if (!font || !XftCharExists(Xdisplay, font, cp))
+        return 0;
+    XftTextExtents32(Xdisplay, font, &cp, 1, &ink);
+    return ink.width <= TermWin.fwidth * eterm_cell_width(cp) &&
+           ink.height <= TermWin.fheight;
+}
+
+static void
+eterm_xft_begin(Drawable drawable)
+{
+    char name[256];
+    int size, nominal_height;
+    XftFont *candidate;
+
+    if (eterm_xft_draw) {
+        XftDrawDestroy(eterm_xft_draw);
+        eterm_xft_draw = NULL;
+    }
+    /* Font size must be recomputed when either grid dimension changes. */
+    if (eterm_xft_cell_height != TermWin.fheight ||
+        eterm_xft_cell_width != TermWin.fwidth) {
+        eterm_xft_close_fonts();
+        eterm_xft_cell_height = TermWin.fheight;
+        eterm_xft_cell_width = TermWin.fwidth;
+    }
+    if (!eterm_xft_primary) {
+        nominal_height = MAX(6, TermWin.fheight - 2);
+        for (size = nominal_height; size >= 6; --size) {
+            snprintf(name, sizeof(name),
+                     "%s:pixelsize=%d:antialias=%s:hinting=true:hintstyle=hintfull:rgba=none",
+                     eterm_xft_family(), size,
+                     eterm_xft_antialias() ? "true" : "false");
+            candidate = XftFontOpenName(Xdisplay, Xscreen, name);
+            if (!candidate)
+                continue;
+            if (eterm_xft_primary)
+                XftFontClose(Xdisplay, eterm_xft_primary);
+            eterm_xft_primary = candidate;
+            eterm_xft_pixel_height = size;
+            /* A glyph with typical monospace advance fits the grid. */
+            if (eterm_xft_glyph_fits(candidate, (FcChar32) 'M'))
+                break;
+        }
+    }
+    if (eterm_xft_primary)
+        eterm_xft_draw = XftDrawCreate(Xdisplay, drawable, Xvisual, cmap);
+}
+
+static void
+eterm_xft_end(void)
+{
+    if (eterm_xft_draw) {
+        XftDrawDestroy(eterm_xft_draw);
+        eterm_xft_draw = NULL;
+    }
+}
+
+static XftFont *
+eterm_xft_find_font(FcChar32 cp)
+{
+    unsigned int i;
+    FcPattern *pattern, *match;
+    FcCharSet *charset;
+    FcResult result;
+    XftFont *font;
+
+    if (!eterm_xft_primary)
+        return NULL;
+    /* Prefer one persistent CJK fontset face to the per-glyph matcher.
+     * The bitmap-first path has already been tried by the caller.
+     */
+    font = eterm_cjk_font_for(cp);
+    if (font)
+        return font;
+    /* If the main face contains the glyph, always use it: no per-character
+     * size changes, even when a glyph protrudes slightly beyond its cell.
+     */
+    if (XftCharExists(Xdisplay, eterm_xft_primary, cp))
+        return eterm_xft_primary;
+    for (i = 0; i < ETERM_XFT_FALLBACK_CACHE; i++) {
+        if (eterm_xft_cache[i].font && eterm_xft_cache[i].codepoint == cp)
+            return eterm_xft_cache[i].font;
+    }
+
+    /* Match missing glyphs at the SAME pixel size, hinting, and antialias
+     * settings as the primary font. Never shrink a glyph independently.
+     * Wide characters have two cells of horizontal drawing space already.
+     */
+    pattern = FcPatternCreate();
+    charset = FcCharSetCreate();
+    if (!pattern || !charset) {
+        if (pattern)
+            FcPatternDestroy(pattern);
+        if (charset)
+            FcCharSetDestroy(charset);
+        return eterm_xft_primary;
+    }
+    FcCharSetAddChar(charset, cp);
+    FcPatternAddString(pattern, FC_FAMILY, (const FcChar8 *) eterm_xft_family());
+    FcPatternAddDouble(pattern, FC_PIXEL_SIZE, (double) eterm_xft_pixel_height);
+    FcPatternAddCharSet(pattern, FC_CHARSET, charset);
+    FcPatternAddBool(pattern, FC_ANTIALIAS, eterm_xft_antialias() ? FcTrue : FcFalse);
+    FcPatternAddBool(pattern, FC_HINTING, FcTrue);
+    FcPatternAddInteger(pattern, FC_HINT_STYLE, FC_HINT_FULL);
+    FcPatternAddInteger(pattern, FC_RGBA, FC_RGBA_NONE);
+    FcCharSetDestroy(charset);
+    FcConfigSubstitute(NULL, pattern, FcMatchPattern);
+    XftDefaultSubstitute(Xdisplay, Xscreen, pattern);
+    match = XftFontMatch(Xdisplay, Xscreen, pattern, &result);
+    FcPatternDestroy(pattern);
+    if (!match)
+        return eterm_xft_primary;
+    font = XftFontOpenPattern(Xdisplay, match);
+    if (!font)
+        return eterm_xft_primary;
+    if (!XftCharExists(Xdisplay, font, cp)) {
+        XftFontClose(Xdisplay, font);
+        return eterm_xft_primary;
+    }
+    i = eterm_xft_replace++ % ETERM_XFT_FALLBACK_CACHE;
+    if (eterm_xft_cache[i].font)
+        XftFontClose(Xdisplay, eterm_xft_cache[i].font);
+    eterm_xft_cache[i].font = font;
+    eterm_xft_cache[i].codepoint = cp;
+    return font;
+}
+
+/* Center the actual ink horizontally, with the baseline of Eterm's
+ * core-font renderer. Clamp vertically to keep ascenders/descenders in
+ * the grid even when fallback fonts have different metrics.
+ */
+static void
+eterm_xft_position_glyph(int row, int col, int span, const XGlyphInfo *ink,
+                         int *x, int *y)
+{
+    int top = Row2Pixel(row);
+    int baseline, lowest, highest;
+
+#ifdef MULTI_CHARSET
+    baseline = top + MAX((encoding_method == LATIN1 ? 0 : TermWin.mfont->ascent),
+                         TermWin.font->ascent);
+#else
+    baseline = top + TermWin.font->ascent;
+#endif
+    *x = Col2Pixel(col) + (TermWin.fwidth * span - (int) ink->width) / 2 - ink->x;
+    lowest = top + ink->y;
+    highest = top + TermWin.fheight - (int) ink->height + ink->y;
+    if (lowest <= highest) {
+        if (baseline < lowest)
+            baseline = lowest;
+        if (baseline > highest)
+            baseline = highest;
+    } else {
+        /* Oversize last-resort font: center the ink within the clip. */
+        baseline = top + (TermWin.fheight - (int) ink->height) / 2 + ink->y;
+    }
+    *y = baseline;
+}
+
+/* Bitmap-first Unicode path, inspired by xterm and urxvt fontset design.
+ * X11 ISO-10646 core fonts contain exact bitmap glyphs, without Xft
+ * rasterisation. Only accept a glyph if its ink fits one or two cells.
+ * Xft remains the fallback if the font is missing the glyph.
+ *
+ * Set ETERM_BITMAP_FONTS to a comma-separated preference list of XLFD
+ * names visible to xlsfonts. These are used before the built-in defaults.
+ */
+#define ETERM_BITMAP_MAX_FONTS 12
+static XFontStruct *eterm_bitmap_fonts[ETERM_BITMAP_MAX_FONTS];
+static unsigned int eterm_bitmap_font_count = 0;
+static int eterm_bitmap_loaded = 0;
+static GC eterm_bitmap_gc = 0;
+
+static void
+eterm_bitmap_try_font(const char *name)
+{
+    XFontStruct *font;
+    unsigned int i;
+    if (!name || !*name || eterm_bitmap_font_count >= ETERM_BITMAP_MAX_FONTS)
+        return;
+    font = XLoadQueryFont(Xdisplay, name);
+    if (!font)
+        return;
+    for (i = 0; i < eterm_bitmap_font_count; i++) {
+        if (eterm_bitmap_fonts[i]->fid == font->fid) {
+            XFreeFont(Xdisplay, font);
+            return;
+        }
+    }
+    eterm_bitmap_fonts[eterm_bitmap_font_count++] = font;
+}
+
+static void
+eterm_bitmap_load_fonts(void)
+{
+    /* Use explicit bitmap fonts first, then bitmap fixed-font fallbacks.
+     * This is font selection, not font scaling: never resize a PCF glyph.
+     */
+    static const char *fallback[] = {
+        "-misc-fixed-medium-r-semicondensed--13-120-75-75-c-60-iso10646-1",
+        "-misc-fixed-medium-r-normal--13-120-75-75-c-70-iso10646-1",
+        "-misc-fixed-medium-r-normal--14-130-75-75-c-70-iso10646-1",
+        "-misc-fixed-medium-r-normal--15-140-75-75-c-90-iso10646-1",
+        "-xos4-terminus-medium-r-normal--14-140-72-72-c-80-iso10646-1"
+    };
+    char names[2048], *token;
+    const char *env;
+    unsigned int i;
+    if (eterm_bitmap_loaded)
+        return;
+    eterm_bitmap_loaded = 1;
+    env = getenv("ETERM_BITMAP_FONTS");
+    if (env && *env) {
+        strncpy(names, env, sizeof(names) - 1);
+        names[sizeof(names) - 1] = 0;
+        for (token = strtok(names, ","); token;
+             token = strtok(NULL, ",")) {
+            while (*token == ' ' || *token == '\t')
+                token++;
+            eterm_bitmap_try_font(token);
+        }
+    }
+    for (i = 0; i < sizeof(fallback) / sizeof(fallback[0]); i++)
+        eterm_bitmap_try_font(fallback[i]);
+}
+
+static int
+eterm_bitmap_glyph_metrics(XFontStruct *font, FcChar32 cp,
+                           XChar2b *ch, XCharStruct *ink)
+{
+    unsigned int high, low;
+    int ncols, index, dir, ascent, descent;
+    XCharStruct *stored;
+    if (!font || cp < 256 || cp > 0xffff ||
+        (cp >= 0xd800 && cp <= 0xdfff))
+        return 0;
+    high = (unsigned int) (cp >> 8);
+    low = (unsigned int) (cp & 255);
+    if (high < font->min_byte1 || high > font->max_byte1 ||
+        low < font->min_char_or_byte2 || low > font->max_char_or_byte2)
+        return 0;
+    /* X11 may otherwise render default_char as a replacement, giving the
+     * false impression that a font provides a particular Unicode glyph.
+     */
+    if (font->per_char) {
+        ncols = font->max_char_or_byte2 - font->min_char_or_byte2 + 1;
+        index = (high - font->min_byte1) * ncols +
+                low - font->min_char_or_byte2;
+        stored = &font->per_char[index];
+        if (!stored->lbearing && !stored->rbearing && !stored->width &&
+            !stored->ascent && !stored->descent && !stored->attributes)
+            return 0;
+    } else if (!font->all_chars_exist) {
+        return 0;
+    }
+    ch->byte1 = (unsigned char) high;
+    ch->byte2 = (unsigned char) low;
+    XTextExtents16(font, ch, 1, &dir, &ascent, &descent, ink);
+    return 1;
+}
+
+static int
+eterm_bitmap_draw(Drawable target, FcChar32 cp, int row, int col,
+                  int span, unsigned long fg, const XRectangle *clip)
+{
+    unsigned int i;
+    XFontStruct *font;
+    XChar2b ch;
+    XCharStruct ink;
+    int width, height, x, y;
+
+    if (cp <= 255 || cp > 0xffff)
+        return 0;
+    eterm_bitmap_load_fonts();
+    for (i = 0; i < eterm_bitmap_font_count; i++) {
+        font = eterm_bitmap_fonts[i];
+        if (font->ascent + font->descent > TermWin.fheight ||
+            !eterm_bitmap_glyph_metrics(font, cp, &ch, &ink))
+            continue;
+        width = ink.rbearing - ink.lbearing;
+        height = ink.ascent + ink.descent;
+        if (width < 1 || width > TermWin.fwidth * span ||
+            height < 1 || height > TermWin.fheight)
+            continue;
+        if (!eterm_bitmap_gc)
+            eterm_bitmap_gc = XCreateGC(Xdisplay, target, 0, NULL);
+        if (!eterm_bitmap_gc)
+            return 0;
+        XSetForeground(Xdisplay, eterm_bitmap_gc, fg);
+        XSetFont(Xdisplay, eterm_bitmap_gc, font->fid);
+        XSetClipRectangles(Xdisplay, eterm_bitmap_gc, 0, 0,
+                           (XRectangle *) clip, 1, Unsorted);
+        x = Col2Pixel(col) + (TermWin.fwidth * span - width) / 2 - ink.lbearing;
+        y = Row2Pixel(row) + (TermWin.fheight - height) / 2 + ink.ascent;
+        XDrawString16(Xdisplay, target, eterm_bitmap_gc, x, y, &ch, 1);
+        return 1;
+    }
+    return 0;
+}
+
+/* v19: One glyph-paint decision for both Unicode rendering backends.
+ * The legacy renderer owns cell-background repair (including image and
+ * transparent backgrounds). This function draws glyph ink only and never
+ * changes the cell background or redraws unchanged cells.
+ */
+static void
+eterm_unicode_draw_cell(Drawable target, int row, int col,
+                        FcChar32 cp, rend_t attrs)
+{
+    int fg, bg, style, swap_tmp, x, y, span, ncols;
+    XColor xcolor;
+    XftColor color;
+    XRectangle clip;
+    XftFont *font;
+    XGlyphInfo ink;
+    FcChar32 glyph;
+
+    ncols = TERM_WINDOW_GET_COLS();
+    span = eterm_cell_width(cp);
+    if (span != 1 && span != 2)
+        return;
+    if (span == 2 && col + 1 >= ncols)
+        return;                 /* Never paint beyond the last grid cell. */
+
+    fg = GET_FGCOLOR(attrs);
+    bg = GET_BGCOLOR(attrs);
+    style = GET_ATTR(attrs);
+    if (style & RS_RVid)
+        SWAP_IT(fg, bg, swap_tmp);
+    if (style & RS_Select)
+        SWAP_IT(fg, bg, swap_tmp);
+    if ((style & RS_Cursor) && TermWin.focus)
+        SWAP_IT(fg, bg, swap_tmp);
+#ifndef NO_BOLDUNDERLINE
+    if ((style & RS_Bold) && fg == fgColor && bg != colorBD)
+        fg = colorBD;
+    else if ((style & RS_Uline) && fg == fgColor && bg != colorUL)
+        fg = colorUL;
+#endif
+
+    clip.x = (short) Col2Pixel(col);
+    clip.y = (short) Row2Pixel(row);
+    clip.width = (unsigned short) (TermWin.fwidth * span);
+    clip.height = (unsigned short) TermWin.fheight;
+
+    xcolor.pixel = PixColors[fg];
+    XQueryColor(Xdisplay, cmap, &xcolor);
+    /* Bitmap and Xft use the same foreground color and clipping area. */
+    if (eterm_bitmap_draw(target, cp, row, col, span, xcolor.pixel, &clip))
+        return;
+
+    if (!eterm_xft_draw)
+        return;
+    font = eterm_xft_find_font(cp);
+    if (!font)
+        return;
+    color.pixel = xcolor.pixel;
+    color.color.red = xcolor.red;
+    color.color.green = xcolor.green;
+    color.color.blue = xcolor.blue;
+    color.color.alpha = 0xffff;
+    glyph = cp;
+    if (!XftCharExists(Xdisplay, font, glyph))
+        glyph = (FcChar32) '?';
+    XftTextExtents32(Xdisplay, font, &glyph, 1, &ink);
+    eterm_xft_position_glyph(row, col, span, &ink, &x, &y);
+    XftDrawSetClipRectangles(eterm_xft_draw, 0, 0, &clip, 1);
+    XftDrawString32(eterm_xft_draw, &color, font, x, y, &glyph, 1);
+}
+
+/* Phase two of the normal Eterm refresh: paint only glyphs whose cells
+ * were repainted in phase one. Waiting until the end of each row avoids
+ * later core-font runs overwriting earlier Unicode glyphs in that row.
+ */
+static void
+eterm_xft_unicode_overlay(int row, int row_offset,
+                         const unsigned char *dirty, Drawable target)
+{
+    int col, cols, span;
+    text_t cp;
+    rend_t attrs;
+
+    /* Keep v18 behavior if Xft cannot initialize; the core-font path
+     * retains its normal '?' fallback instead of blending bitmap ink over it.
+     */
+    if (!eterm_xft_draw)
+        return;
+    cols = TERM_WINDOW_GET_COLS();
+    for (col = 0; col < cols; ++col) {
+        cp = screen.text[row + row_offset][col];
+        span = eterm_cell_width(cp);
+        if (!dirty[col] && !(span == 2 && col + 1 < cols && dirty[col + 1]))
+            continue;
+        attrs = drawn_rend[row][col];
+        if (cp == ETERM_WIDE_TRAIL || (attrs & RS_acsFont) ||
+            cp < 33 || (cp <= 255 && !eterm_xft_all_text()))
+            continue;
+        eterm_unicode_draw_cell(target, row, col, (FcChar32) cp, attrs);
+    }
+}
