+/* Returns a rendition-safe 9-bit color index. Does not advertise truecolor
+ * terminfo: this bounded cache cannot represent an unlimited RGB image. */
+static unsigned int
+eterm_rgb_color(unsigned int red, unsigned int green, unsigned int blue)
+{
+    unsigned int idx, rgb;
+    XColor xcolor;
+
+    if (red > 255 || green > 255 || blue > 255)
+        return fgColor;
+    if (Xdepth <= 2)
+        return fgColor;
+    rgb = (red << 16) | (green << 8) | blue;
+
+    for (idx = TOTAL_COLORS; idx < eterm_rgb_next; ++idx) {
+        if (eterm_rgb_values[idx] == rgb)
+            return idx;
+    }
+    if (eterm_rgb_next >= ETERM_COLOR_STORAGE ||
+        eterm_rgb_next >= 512) /* 9-bit color masks in screen.h */
+        return eterm_rgb_nearest(rgb);
