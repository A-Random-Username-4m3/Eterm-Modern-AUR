+
+/* When a screen needs more than the finite number of distinct RGB colors,
+ * approximate with a stable existing palette entry. Keep its contents
+ * immutable so existing saved cells do not change appearance. */
+static unsigned int
+eterm_rgb_nearest(unsigned int rgb)
+{
+    unsigned int idx, best = 7;
+    unsigned long distance, smallest = ULONG_MAX;
+    XColor xcolor;
+
+    if (!eterm_rgb_base_cached) {
+        for (idx = 0; idx < 256; ++idx) {
+            xcolor.pixel = PixColors[idx];
+            if (XQueryColor(Xdisplay, cmap, &xcolor)) {
+                eterm_rgb_base_valid[idx] = 1;
+                eterm_rgb_base_values[idx] =
+                    (((unsigned int) (xcolor.red >> 8)) << 16) |
+                    (((unsigned int) (xcolor.green >> 8)) << 8) |
+                    ((unsigned int) (xcolor.blue >> 8));
+            }
+        }
+        eterm_rgb_base_cached = 1;
+    }
+    for (idx = 0; idx < 256; ++idx) {
+        if (!eterm_rgb_base_valid[idx])
+            continue;
+        distance = eterm_rgb_distance(rgb, eterm_rgb_base_values[idx]);
+        if (distance < smallest) {
+            smallest = distance;
+            best = idx;
+        }
+    }
+    for (idx = TOTAL_COLORS; idx < eterm_rgb_next; ++idx) {
+        distance = eterm_rgb_distance(rgb, eterm_rgb_values[idx]);
+        if (distance < smallest) {
+            smallest = distance;
+            best = idx;
+        }
+    }
+    return best;
