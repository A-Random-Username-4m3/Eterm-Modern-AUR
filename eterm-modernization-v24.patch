+/* DEC Special Graphics character codes supported by Eterm's RS_acsFont.
+ * Return zero if no mapping exists. These are one-column approximations.
+ */
+static unsigned char
+eterm_utf8_acs(unsigned long cp)
+{
+    switch (cp) {
+        case 0x2500: case 0x2501: case 0x2550: return 'q'; /* horizontal */
+        case 0x2502: case 0x2503: case 0x2551: return 'x'; /* vertical */
+        case 0x250c: case 0x250f: case 0x2554: return 'l'; /* top left */
+        case 0x2510: case 0x2513: case 0x2557: return 'k'; /* top right */
+        case 0x2514: case 0x2517: case 0x255a: return 'm'; /* bottom left */
+        case 0x2518: case 0x251b: case 0x255d: return 'j'; /* bottom right */
+        case 0x251c: case 0x2523: case 0x2560: return 't'; /* left tee */
+        case 0x2524: case 0x252b: case 0x2563: return 'u'; /* right tee */
+        case 0x252c: case 0x2533: case 0x2566: return 'w'; /* top tee */
+        case 0x2534: case 0x253b: case 0x2569: return 'v'; /* bottom tee */
+        case 0x253c: case 0x254b: case 0x256c: return 'n'; /* crossing */
+        case 0x2264: return 'y'; /* less than or equal */
+        case 0x2265: return 'z'; /* greater than or equal */
+        case 0x2260: return '|'; /* not equal */
+        case 0x03c0: return '{'; /* pi */
+        case 0x00b1: return 'g'; /* plus/minus */
+        case 0x00b0: return 'f'; /* degree */
+        case 0x2022: return '~'; /* bullet */
+        default: return 0;
+    }
