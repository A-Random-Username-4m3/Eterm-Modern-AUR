+/* DECSET 1006 (SGR) and 1002 (button-motion) reporting.
+ * release: true for button release; motion: true for held-button movement.
+ */
+void
+mouse_report_extended(XButtonEvent *ev, int release, int motion)
+{
+    int button_number;
+    int modifiers = 0;
+    int col = Pixel2Col(ev->x) + 1;
+    int row = Pixel2Row(ev->y) + 1;
+
+    switch (ev->button) {
+        case Button1:
+        case Button2:
+        case Button3:
+            button_number = ev->button - Button1;
+            break;
+        case Button4:
+        case Button5:
+            button_number = 64 + ev->button - Button4;
+            break;
+        default:
+            return;
+    }
+    if (ev->state & ShiftMask)
+        modifiers |= 4;
+    if (ev->state & Mod1Mask)
+        modifiers |= 8;
+    if (ev->state & ControlMask)
+        modifiers |= 16;
+    if (motion)
+        modifiers |= 32;
+    if (col < 1)
+        col = 1;
+    if (row < 1)
+        row = 1;
+    if (col > TERM_WINDOW_GET_REPORTED_COLS())
+        col = TERM_WINDOW_GET_REPORTED_COLS();
+    if (row > TERM_WINDOW_GET_REPORTED_ROWS())
+        row = TERM_WINDOW_GET_REPORTED_ROWS();
+
+    if (PrivateModes & PrivMode_MouseSGR) {
+        tt_printf((unsigned char *) "\033[<%d;%d;%d%c",
+                  button_number | modifiers, col, row, release ? 'm' : 'M');
+    } else {
+        if (release)
+            button_number = 3;
+        if (col > 223)
+            col = 223;
+        if (row > 223)
+            row = 223;
+        tt_printf((unsigned char *) "\033[M%c%c%c",
+                  32 + (button_number | modifiers), 32 + col, 32 + row);
+    }
+}
