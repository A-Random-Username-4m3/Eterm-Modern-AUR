+/* v18: persistent CJK faces, independent of per-character Fontconfig matching.
+ * Keep X11 ISO-10646 bitmap glyphs as the first choice in the draw loop.
+ * Non-CJK Unicode still uses the original Xft fallback cache.
+ *
+ * ETERM_CJK_FONT:         primary family (default Noto Sans Mono CJK JP)
+ * ETERM_CJK_FALLBACK:     alternate family (default Noto Sans Mono CJK SC)
+ * ETERM_CJK_PIXEL_SIZE:   optional shared CJK pixel size, 6..64
+ *
+ * These settings are read when the terminal opens its first CJK glyph.
+ * Fonts are reopened if the cell geometry changes. No per-glyph resizing.
+ */
+#define ETERM_CJK_FACE_COUNT 2
+static XftFont *eterm_cjk_faces[ETERM_CJK_FACE_COUNT] = { NULL, NULL };
+static int eterm_cjk_ready = 0;
+
+static void
+eterm_cjk_close_fonts(void)
+{
+    unsigned int i;
+    for (i = 0; i < ETERM_CJK_FACE_COUNT; i++) {
+        if (eterm_cjk_faces[i]) {
+            XftFontClose(Xdisplay, eterm_cjk_faces[i]);
+            eterm_cjk_faces[i] = NULL;
+        }
+    }
+    eterm_cjk_ready = 0;
+}
+
+/* Do not use the CJK face for emoji, mathematical symbols, or other scripts. */
+static int
+eterm_is_cjk(FcChar32 cp)
+{
+    return (cp >= 0x2e80 && cp <= 0x2fff) ||
+           (cp >= 0x3000 && cp <= 0x303f) ||
+           (cp >= 0x3040 && cp <= 0x30ff) ||
+           (cp >= 0x3100 && cp <= 0x312f) ||
+           (cp >= 0x3130 && cp <= 0x318f) ||
+           (cp >= 0x31a0 && cp <= 0x31ff) ||
+           (cp >= 0x3200 && cp <= 0x9fff) ||
+           (cp >= 0xac00 && cp <= 0xd7af) ||
+           (cp >= 0xf900 && cp <= 0xfaff) ||
+           (cp >= 0xff00 && cp <= 0xffef) ||
+           (cp >= 0x20000 && cp <= 0x3134f);
+}
+
+static XftFont *
+eterm_cjk_open_face(const char *family, int pixelsize)
+{
+    char pattern[384];
+    if (!family || !*family)
+        return NULL;
+    snprintf(pattern, sizeof(pattern),
+             "%s:pixelsize=%d:antialias=%s:hinting=true:hintstyle=hintslight:rgba=none",
+             family, pixelsize, eterm_xft_antialias() ? "true" : "false");
+    return XftFontOpenName(Xdisplay, Xscreen, pattern);
+}
+
+/* Choose size once for the WHOLE CJK font, not separately for every glyph.
+ * A representative ideograph provides a conservative fit test, with the
+ * original two-cell clipping rectangle remaining the final safety bound.
+ */
+static int
+eterm_cjk_sample_fits(XftFont *font)
+{
+    const FcChar32 sample = 0x4e00;  /* CJK ideograph ONE */
+    XGlyphInfo extents;
+    if (!font)
+        return 0;
+    if (!XftCharExists(Xdisplay, font, sample))
+        return 1;  /* Some alternate faces may contain kana or hangul only. */
+    XftTextExtents32(Xdisplay, font, &sample, 1, &extents);
+    return extents.width <= (unsigned int) (TermWin.fwidth * 2) &&
+           extents.height <= (unsigned int) TermWin.fheight;
+}
