+
+static unsigned char
+eterm_legacy_glyph(text_t cp, rend_t style)
+{
+#ifdef MULTI_CHARSET
+    if ((style & RS_acsFont) && cp > 255) {
+        unsigned char acs = eterm_utf8_acs(cp);
+        if (acs)
+            return acs;
+    }
+#endif
+    if (cp == ETERM_WIDE_TRAIL)
+        return ' ';
+    if (eterm_xft_draw && !(style & RS_acsFont) &&
+        (cp > 255 || (eterm_xft_all_text() && cp >= 32)))
+        return ' ';
+    return (cp <= 255) ? (unsigned char) cp : '?';
+}
