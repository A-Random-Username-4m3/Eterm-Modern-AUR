+static unsigned char eterm_rgb_base_valid[256];
+static unsigned int eterm_rgb_base_values[256];
+static int eterm_rgb_base_cached = 0;
+
+static unsigned long
+eterm_rgb_distance(unsigned int a, unsigned int b)
+{
+    long dr = (long) ((a >> 16) & 255) - (long) ((b >> 16) & 255);
+    long dg = (long) ((a >> 8) & 255) - (long) ((b >> 8) & 255);
+    long db = (long) (a & 255) - (long) (b & 255);
+    return (unsigned long) (dr * dr + dg * dg + db * db);
