+/* Only used when feeding 8-bit X11 core fonts. Never write the fallback
+ * character into screen.text: we need the real scalar for later Xft work.
+ */
+/* Unicode cell widths belong to the terminal grid, not the glyph font.
+ * Currently supports simple 2-column scalars; not combining sequences or ZWJ.
+ */
+static int
+eterm_cell_width(text_t cp)
+{
+#ifdef MULTI_CHARSET
+    if (encoding_method == UTF8 && cp <= 0x10ffff)
+        return wcwidth((wchar_t) cp) == 2 ? 2 : 1;
+#endif
+    return 1;
+}
+
+/* v23: Compose a zero-column combining mark with the preceding screen
+ * scalar when Unicode provides a single NFC code point.  The existing
+ * one-code-point-per-cell layout can safely represent that result without
+ * moving the cursor or adding a new sidecar buffer.  Unsupported sequences
+ * fall through to the old path; they will be addressed by cluster storage.
+ *
+ * A base character may be the final column (Screen_WrapNext) or the first
+ * half of a two-column character.  Never compose across row boundaries.
+ */
+#ifdef MULTI_CHARSET
+static int
+eterm_compose_previous_mark(text_t mark)
+{
+    utf8proc_category_t cat;
+    utf8proc_int32_t pair[2];
+    utf8proc_ssize_t result;
+    text_t base, composed;
+    int row, col, base_width;
+
+    if (encoding_method != UTF8 || mark > 0x10ffffu)
+        return 0;
+    cat = utf8proc_category((utf8proc_int32_t) mark);
+    if (cat != UTF8PROC_CATEGORY_MN && cat != UTF8PROC_CATEGORY_MC &&
+        cat != UTF8PROC_CATEGORY_ME)
+        return 0;
+    if (utf8proc_charwidth((utf8proc_int32_t) mark) != 0)
+        return 0;
+
+    if (!(screen.flags & Screen_WrapNext) && screen.col < 1)
+        return 0;
+    row = screen.row + TermWin.saveLines;
+    if (!screen.text[row] || !screen.rend[row])
+        return 0;
+    col = (screen.flags & Screen_WrapNext) ? screen.col : screen.col - 1;
+    if (col < 0 || col >= TERM_WINDOW_GET_REPORTED_COLS())
+        return 0;
+    if (screen.text[row][col] == ETERM_WIDE_TRAIL)
+        --col;
+    if (col < 0)
+        return 0;
+    base = screen.text[row][col];
+    if (base <= ' ' || base > 0x10ffffu ||
+        (screen.rend[row][col] & RS_acsFont))
+        return 0;
+    base_width = eterm_cell_width(base);
+    if (base_width != 1 && base_width != 2)
+        return 0;
+    pair[0] = (utf8proc_int32_t) base;
+    pair[1] = (utf8proc_int32_t) mark;
+    result = utf8proc_normalize_utf32(pair, 2,
+                                     UTF8PROC_COMPOSE | UTF8PROC_STABLE);
+    if (result != 1 || pair[0] < 0 || pair[0] > 0x10ffff)
+        return 0;
+    composed = (text_t) pair[0];
+    if (composed == base || eterm_cell_width(composed) != base_width)
+        return 0;
+
+    /* A held selection must not continue referring to changed contents. */
+    if (selection.op)
+        selection_reset();
+    screen.text[row][col] = composed;
+    /* The normal dirty-cell comparison repaints the changed scalar. */
+    return 1;
+}
+#endif
