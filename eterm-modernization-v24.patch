+/* Narrow compatibility bridge, NOT a full Unicode display engine.
+ * These state variables persist when a UTF-8 character is split between reads.
+ */
+static unsigned long eterm_utf8_value = 0;
+static unsigned long eterm_utf8_minimum = 0;
+static int eterm_utf8_remaining = 0;
+
+/* Return 0 for incomplete input and 1 when *codepoint is available.
+ * On an invalid continuation, replay the unexpected byte on the next step.
+ */
+static int
+eterm_utf8_next(unsigned char byte, unsigned long *codepoint, int *replay)
+{
+    *replay = 0;
+    if (eterm_utf8_remaining) {
+        if ((byte & 0xc0) != 0x80) {
+            eterm_utf8_remaining = 0;
+            *codepoint = '?';
+            *replay = 1;
+            return 1;
+        }
+        eterm_utf8_value = (eterm_utf8_value << 6) | (byte & 0x3f);
+        if (--eterm_utf8_remaining)
+            return 0;
+        *codepoint = eterm_utf8_value;
+        if (*codepoint < eterm_utf8_minimum ||
+            *codepoint > 0x10ffffUL ||
+            (*codepoint >= 0xd800 && *codepoint <= 0xdfff))
+            *codepoint = '?';
+        return 1;
+    }
+    if (byte < 0x80) {
+        *codepoint = byte;
+        return 1;
+    }
+    if (byte >= 0xc2 && byte <= 0xdf) {
+        eterm_utf8_value = byte & 0x1f;
+        eterm_utf8_minimum = 0x80;
+        eterm_utf8_remaining = 1;
+    } else if (byte >= 0xe0 && byte <= 0xef) {
+        eterm_utf8_value = byte & 0x0f;
+        eterm_utf8_minimum = 0x800;
+        eterm_utf8_remaining = 2;
+    } else if (byte >= 0xf0 && byte <= 0xf4) {
+        eterm_utf8_value = byte & 0x07;
+        eterm_utf8_minimum = 0x10000;
+        eterm_utf8_remaining = 3;
+    } else {
+        *codepoint = '?';
+        return 1;
+    }
+    return 0;
+}
